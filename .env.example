# ── Application ──────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/hybrid_lms

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Argon2id (NIST SP 800-63-4) ──────────────────────────────
ARGON2_MEMORY_KB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# ── Rate Limiting (Android-style exponential backoff) ────────
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_BASE_LOCKOUT_SECONDS=30
RATE_LIMIT_MAX_LOCKOUT_SECONDS=1800

# ── Gmail (OAuth2 — gmail.send scope only) ───────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

#-----AES-256-GCM----
ENCRYPTION_MASTER_KEY=

#-----OAUTH2--------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ── Malware Scanning (ClamAV) ────────────────────────────────
# Using 127.0.0.1 because Node runs on host, routing to Docker port 3310
CLAMD_HOST=
CLAMD_PORT=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REFUND_ESCALATION_THRESHOLD=

# ── Certificate Digital Signing (Ed25519 — CERT module) ──────
# Generate once via Node's built-in crypto (no external tool/dependency):
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}));console.log(publicKey.export({type:'spki',format:'pem'}))"
# Store the two PEM blocks below as single-line values with \n escapes,
# or use your platform's multiline secret support (e.g. Render's
# "Secret File" / multiline env var editor) — never commit the real PEM.
# Rotate by generating a NEW pair and bumping CERT_SIGNING_KEY_VERSION;
# keep the OLD public key available in code if verification of
# already-issued certificates must keep working after rotation.
CERT_SIGNING_PRIVATE_KEY_PEM=
CERT_SIGNING_PUBLIC_KEY_PEM=
CERT_SIGNING_KEY_VERSION=v1